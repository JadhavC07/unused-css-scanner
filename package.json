{
  "name": "unused-css-scanner",
  "version": "2.0.0",
  "description": "Production-grade scanner for unused CSS/StyleSheet in React Native and React",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "unused-css-scanner": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run test && npm run build",
    "prepare": "npm run build"
  },
  "keywords": [
    "css",
    "unused",
    "scanner",
    "react-native",
    "stylesheet",
    "analyzer",
    "code-quality",
    "linter",
    "cleanup",
    "refactor"
  ],
  "author": "Chandan Jadhav <cjaddhav@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JadhavC07/unused-css-scanner.git"
  },
  "bugs": {
    "url": "https://github.com/JadhavC07/unused-css-scanner/issues"
  },
  "homepage": "https://github.com/JadhavC07/unused-css-scanner#readme",
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.19.25",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.4",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=14.0.0"
  }
}
